    <string name="signal_remote_access">திரை-பகிர்வு அல்லது ரிமோட்-ஆக்சஸ் செயலி செயல்பாட்டில் உள்ளது</string>
    <string name="signal_accessibility">நம்பகமற்ற செயலி அணுகல்தன்மை அம்சங்களைக் கட்டுப்படுத்தலாம்</string>
    <string name="signal_unknown_call">தெரியாத எண்ணிலிருந்து அழைப்பு செயல்பாட்டில் உள்ளது</string>
    <string name="signal_collect">இது ஒரு கலெக்ட் கோரிக்கை — பணம் பெறுவதற்கு ஒருபோதும் பணம் செலுத்தத் தேவையில்லை</string>
    <string name="signal_phishing">சமீபத்தில் ஒரு சந்தேகத்திற்குரிய இணைப்பு திறக்கப்பட்டது</string>
    <string name="signal_qr">QR குறியீட்டை ஸ்கேன் செய்வதற்கு முன் வணிகர் மற்றும் தொகையைச் சரிபார்க்கவும்</string>

