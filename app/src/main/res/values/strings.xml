    <!-- Guide Steps -->
    <string name="guide_title">App Guide</string>
    <string name="guide_step_1_title">1. Real-time Monitoring</string>
    <string name="guide_step_1_desc">GramKavach runs in the background and monitors for suspicious activities like unknown callers or remote access apps.</string>
    <string name="guide_step_2_title">2. Smart Risk Analysis</string>
    <string name="guide_step_2_desc">When a potential fraud is detected, you will see a risk score and a detailed breakdown of why the alert was generated.</string>
    <string name="guide_step_3_title">3. Local Voice Alerts</string>
    <string name="guide_step_3_desc">Receive instant voice warnings in your own language to stay alert during high-pressure situations.</string>
    <string name="guide_step_4_title">4. Emergency Reporting</string>
    <string name="guide_step_4_desc">Immediately report fraud attempts to the Cyber Cell by calling 1930 directly from the app.</string>
