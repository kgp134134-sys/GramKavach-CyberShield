    <!-- Manual Tips -->
    <string name="manual_donts_header">Don\'ts (ये भूल न करें)</string>
    <string name="tip_dont_1">Kisi bhi SMS, WhatsApp ya Email par aaye anjaan link par click na karein.</string>
    <string name="tip_dont_2">Lottery, Electricity Bill, SIM Block ya Bank Account Suspend jaise SMS par bharosa na karein.</string>
    <string name="tip_dont_3">SMS ya WhatsApp se aayi APK/file download na karein.</string>
    <string name="tip_dont_4">Anjaan call par AnyDesk, TeamViewer ya kisi bhi screen-sharing app ko download na karein.</string>
    <string name="tip_dont_5">Paise LENE ke liye kabhi bhi UPI PIN mat daalein.</string>
    <string name="tip_dont_6">Apna OTP, UPI PIN ya Password kisi ke saath share na karein.</string>

    <string name="manual_dos_header">Do\'s (हमेसा याद रखें)</string>
    <string name="tip_do_1">UPI PIN ka use sirf paise BHEJNE ya balance check karne ke liye karein.</string>
    <string name="tip_do_2">QR Code scan karne se pehle vyakti ya dukaan ka naam verify karein.</string>
    <string name="tip_do_3">Apps sirf official app store se hi download karein.</string>
    <string name="tip_do_4">Fraud hone par turant 1930 Cyber Helpline par call karein.</string>

