    <string name="about_desc">GramKavach is a local-first digital financial safety assistant designed to protect rural and first-time digital-payment users from UPI fraud.</string>
    <string name="tech_stack">Tech Stack:</string>
    <string name="safer_india">Built for safer digital India</string>

    <!-- Analysis Scenarios -->
    <string name="source_bank_scam">Unknown Caller + Remote Access App</string>
    <string name="why_bank_scam">Multiple high-risk indicators suggest a possible social engineering attempt.</string>
    <string name="action_bank_scam">End the call immediately, close any remote-access app, and never share your OTP or UPI PIN.</string>

    <string name="source_collect">UPI Collect Request</string>
    <string name="why_collect">A collect request asks you to authorize a payment. Receiving money never requires entering your UPI PIN.</string>
    <string name="action_collect">Verify the sender before approving the request. Reject unexpected collect requests.</string>

    <string name="source_phishing">SMS/WhatsApp Link</string>
    <string name="why_phishing">Suspicious or unverified link detected that may attempt to steal personal or banking information.</string>
    <string name="action_phishing">Do not open the link or enter any sensitive information. Verify the sender first.</string>

    <string name="source_qr">External QR Code</string>
    <string name="why_qr">The scanned QR code initiates a payment request. Always verify the recipient and amount before entering your UPI PIN.</string>
    <string name="action_qr">Confirm the merchant and payment details before proceeding.</string>

