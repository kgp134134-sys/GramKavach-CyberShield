    <string name="guide_title">অ্যাপ গাইড</string>
    <string name="guide_step_1_title">১. রিয়েল-টাইম মনিটরিং</string>
    <string name="guide_step_1_desc">গ্রামকবচ ব্যাকগ্রাউন্ডে চলে এবং অজানা কলার বা রিমোট অ্যাক্সেস অ্যাপের মতো সন্দেহজনক কার্যকলাপ পর্যবেক্ষণ করে।</string>
    <string name="guide_step_2_title">২. স্মার্ট ঝুঁকি বিশ্লেষণ</string>
    <string name="guide_step_2_desc">যখন একটি সম্ভাব্য প্রতারণা শনাক্ত হয়, আপনি একটি ঝুঁকি স্কোর এবং কেন সতর্কতাটি তৈরি করা হয়েছিল তার বিস্তারিত বিবরণ দেখতে পাবেন।</string>
    <string name="guide_step_3_title">৩. স্থানীয় ভয়েস সতর্কতা</string>
    <string name="guide_step_3_desc">উচ্চ-চাপের পরিস্থিতিতে সতর্ক থাকতে আপনার নিজের ভাষায় তাৎক্ষণিক ভয়েস সতর্কতা পান।</string>
    <string name="guide_step_4_title">৪. জরুরি রিপোর্টিং</string>
    <string name="guide_step_4_desc">সরাসরি অ্যাপ থেকে ১৯৩০ নম্বরে কল করে প্রতারণার চেষ্টা সম্পর্কে অবিলম্বে সাইবার সেলকে জানান।</string>
