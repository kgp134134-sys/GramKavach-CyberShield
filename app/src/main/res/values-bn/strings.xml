    <string name="action_bank_scam">কলটি অবিলম্বে শেষ করুন, রিমোট-অ্যাক্সেস অ্যাপ বন্ধ করুন এবং আপনার OTP বা UPI পিন শেয়ার করবেন না।</string>

    <string name="source_collect">UPI কালেক্ট অনুরোধ</string>
    <string name="why_collect">কালেক্ট অনুরোধ আপনাকে একটি পেমেন্ট অনুমোদন করতে বলে। টাকা পেতে কখনও UPI পিনের প্রয়োজন হয় না।</string>
    <string name="action_collect">অনুরোধ অনুমোদনের আগে প্রেরককে যাচাই করুন। অপ্রত্যাশিত কালেক্ট অনুরোধ প্রত্যাখ্যান করুন।</string>

    <string name="source_phishing">SMS/WhatsApp লিঙ্ক</string>
    <string name="why_phishing">সন্দিগ্ধ লিঙ্ক পাওয়া গেছে যা ব্যক্তিগত বা ব্যাঙ্কিং তথ্য চুরির চেষ্টা করতে পারে।</string>
    <string name="action_phishing">লিঙ্কটি খুলবেন না বা কোনো সংবেদনশীল তথ্য দেবেন না। প্রথমে প্রেরককে যাচাই করুন।</string>

    <string name="source_qr">বাইরের QR কোড</string>
    <string name="why_qr">স্ক্যান করা QR কোড একটি পেমেন্ট অনুরোধ শুরু করে। UPI পিন দেওয়ার আগে সর্বদা প্রাপক এবং পরিমাণ যাচাই করুন।</string>
    <string name="action_qr">এগিয়ে যাওয়ার আগে মার্চেন্ট এবং পেমেন্টের বিবরণ নিশ্চিত করুন।</string>

